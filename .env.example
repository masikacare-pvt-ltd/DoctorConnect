# ==========================================
# DoctorConnect Environment Template
# ==========================================

# Frontend
VITE_API_URL=http://localhost:5000

# Backend
PORT=5000
CLIENT_URL=http://localhost:3000

# Production URLs (set these when deploying)
# BETTER_AUTH_URL=https://your-render-app.onrender.com
# CLIENT_URL=https://your-vercel-app.vercel.app
# VITE_API_URL=https://your-render-app.onrender.com

# Neon PostgreSQL Database
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth Secret (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET="your-secret-here"

# Groq AI Analysis
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# -----------------
# Admin Panel Credentials (REQUIRED — server will refuse to start in production without these)
# Generate ADMIN_TOKEN_SECRET with: openssl rand -hex 32
# -----------------
NODE_ENV=production
ADMIN_ID=your_admin_username
ADMIN_PASSWORD=YourStrongPassword12+
ADMIN_TOKEN_SECRET=replace-with-output-of-openssl-rand-hex-32

# -----------------
# Email / SMTP (REQUIRED for email verification — auto-disabled if not set)
# Recommended: Resend.com (free tier: 3,000 emails/month)
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=re_...
# -----------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

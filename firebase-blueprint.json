{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document in Firestore",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "User's first name"
        },
        "lastName": {
          "type": "string",
          "description": "User's last name"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "mobile": {
          "type": "string",
          "description": "User's mobile number"
        },
        "designation": {
          "type": "string",
          "description": "Medical designation (e.g. Cardiologist)"
        },
        "department": {
          "type": "string",
          "description": "Department of medicine"
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to profile picture"
        },
        "hospital": {
          "type": "string",
          "description": "Affiliated hospital name"
        },
        "bio": {
          "type": "string",
          "description": "Biography/Credential details"
        }
      },
      "required": ["firstName", "lastName", "email"]
    },
    "ClinicalCase": {
      "title": "Clinical Case",
      "description": "Clinical case description and metadata",
      "type": "object",
      "properties": {
        "caseNumber": {
          "type": "string",
          "description": "Unique identifier of the case"
        },
        "title": {
          "type": "string",
          "description": "Title of the clinical case"
        },
        "authorName": {
          "type": "string",
          "description": "Full name of the authoring doctor"
        },
        "authorRole": {
          "type": "string",
          "description": "Role/Specialty of the authoring doctor"
        },
        "authorAvatar": {
          "type": "string",
          "description": "Avatar image URL of the author"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the author"
        },
        "category": {
          "type": "string",
          "description": "Specialty category (e.g. Dermatology, Radiology)"
        },
        "timestamp": {
          "type": "string",
          "description": "Readable duration since creation"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp string of when the case was submitted"
        },
        "description": {
          "type": "string",
          "description": "Detailed clinical case description"
        },
        "image": {
          "type": "string",
          "description": "Primary visual scan or medical image URL"
        },
        "secondaryImage": {
          "type": "string",
          "description": "Secondary visual scan or medical image URL"
        },
        "commentsCount": {
          "type": "integer",
          "description": "Calculated number of clinical comments/reviews"
        },
        "viewsCount": {
          "type": "integer",
          "description": "Number of visual views"
        },
        "diseaseTags": {
          "type": "array",
          "description": "Target disease classifications"
        },
        "urgent": {
          "type": "boolean",
          "description": "Urgency flag for priority review"
        },
        "caseQuote": {
          "type": "string",
          "description": "Highlight medical quotes from clinical history"
        },
        "labResultsLink": {
          "type": "string",
          "description": "Virtual or PDF reference link to clinical charts"
        }
      },
      "required": ["title", "authorName", "category", "description", "image"]
    },
    "CaseComment": {
      "title": "Case Comment",
      "description": "Discussion post/review on a clinical case",
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "description": "Reference ID of the parent clinical case"
        },
        "authorName": {
          "type": "string",
          "description": "Reviewing physician name"
        },
        "authorRole": {
          "type": "string",
          "description": "Reviewing physician role/specialty"
        },
        "authorAvatar": {
          "type": "string",
          "description": "Reviewing physician avatar URL"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the comment author"
        },
        "timestamp": {
          "type": "string",
          "description": "Readable elapsed time string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp string of comment submission"
        },
        "text": {
          "type": "string",
          "description": "Full discussion response text"
        },
        "attachmentName": {
          "type": "string",
          "description": "Name of any PDF or image attachments"
        }
      },
      "required": ["caseId", "authorName", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Store registered doctor and guest user profiles"
    },
    "/cases/{caseId}": {
      "schema": "ClinicalCase",
      "description": "Store all shared medical clinical cases"
    },
    "/comments/{commentId}": {
      "schema": "CaseComment",
      "description": "Clinical discussions and peer feedback per medical case"
    }
  }
}
